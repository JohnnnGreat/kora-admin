generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlatformAdminStatus {
  invited
  active
  disabled
}

enum PlatformMfaKind {
  totp
}

enum PlatformAuditOutcome {
  success
  failure
}

enum PlatformEmailCampaignStatus {
  draft
  scheduled
  queued
  sending
  paused
  sent
  failed
  cancelled
}

enum PlatformEmailDeliveryStatus {
  pending
  processing
  sent
  delivered
  opened
  bounced
  complained
  failed
  skipped
}

// Who decides an organization's billing: the organization itself (today's
// only behaviour, via its own tenant-side subscription-billing feature) or
// the platform, centrally. "self" is the default for every organization
// that has no PlatformOrganizationBillingMode row at all — this table only
// ever holds overrides away from the global default
// (PlatformBillingSettings.defaultMode), never a row for every tenant.
enum PlatformBillingMode {
  self
  platform
}

model PlatformAdmin {
  id             String              @id @default(uuid())
  email          String              @unique
  name           String
  // Null while status is "invited" — set the moment the invite is accepted.
  // Kept a plain nullable column rather than a separate table since an
  // invite is 1:1 with the admin row it creates, unlike PlatformSession
  // (many per admin) or PlatformMfaMethod (also many, and genuinely
  // optional even once active).
  passwordHash   String?
  status         PlatformAdminStatus @default(invited)
  lastLoginAt    DateTime?
  passwordSetAt  DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Hashed the same way as PlatformSession.tokenHash — the raw token only
  // ever exists in the invite email, never stored. Null once accepted
  // (cleared alongside setting passwordHash) or if this admin was created
  // directly (the original bootstrap script still upserts with status
  // "active" and a real passwordHash, skipping the invite flow entirely).
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  invitedById     String?
  invitedBy       PlatformAdmin?  @relation("PlatformAdminInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invited         PlatformAdmin[] @relation("PlatformAdminInvites")

  roles       PlatformAdminRole[]
  sessions    PlatformSession[]
  mfaMethods  PlatformMfaMethod[]
  auditEvents PlatformAuditEvent[]
  emailCampaigns PlatformEmailCampaign[]
  billingModeChanges    PlatformOrganizationBillingMode[]
  managedBillingChanges PlatformManagedBilling[]
  billingSettingsChanges PlatformBillingSettings[]
  systemSettingsChanges PlatformSystemSettings[]

  @@map("platform_admins")
}

// One row per organization that has ever been overridden away from the
// global default (PlatformBillingSettings.defaultMode) — an organization
// with no row here simply follows the default. organizationId is a tenant
// id from the tenant database (see TenantDatabaseService), not a local FK:
// the two databases are separate, same reason EmailDelivery.recipientUserId
// is a bare string rather than a relation.
model PlatformOrganizationBillingMode {
  id             String              @id @default(uuid())
  organizationId String              @unique
  mode           PlatformBillingMode
  note           String?             @db.Text
  setById        String
  setAt          DateTime            @default(now())

  setBy PlatformAdmin @relation(fields: [setById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("platform_organization_billing_modes")
}

// The admin-owned billing record for an organization in "platform" mode —
// a parallel, lightweight record to the tenant's own billing_subscriptions
// row, never a write into the tenant's database. Only meaningful (and only
// shown to anyone) while that organization's resolved mode is "platform";
// switching an org back to "self" leaves this row in place, inert, rather
// than deleting history.
model PlatformManagedBilling {
  id             String   @id @default(uuid())
  organizationId String   @unique
  planName       String
  amountMinor    Int
  currency       String   @default("NGN")
  interval       String   @default("monthly")
  status         String   @default("active")
  notes          String   @default("") @db.Text
  updatedById    String
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  updatedBy PlatformAdmin @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("platform_managed_billing")
}

// Singleton (id is always the literal string "default") — the fallback mode
// for any organization without its own PlatformOrganizationBillingMode row.
model PlatformBillingSettings {
  id          String              @id @default("default")
  defaultMode PlatformBillingMode @default(self)
  updatedById String?
  updatedAt   DateTime            @updatedAt

  updatedBy PlatformAdmin? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("platform_billing_settings")
}

// Singleton (id is always the literal string "default") — platform-wide
// policy defaults every organization inherits, distinct from the tenant
// side's FeatureModule/TenantModule tables (which gate what's enabled per
// individual organization, not what's available on the platform at all).
model PlatformSystemSettings {
  id                     String   @id @default("default")
  multiCurrencyEnabled   Boolean  @default(true)
  multiLanguageEnabled   Boolean  @default(false)
  customBrandingEnabled  Boolean  @default(true)
  whiteLabelEmailEnabled Boolean  @default(false)
  ipAllowlistingEnabled  Boolean  @default(true)
  enforceSessionTimeout  Boolean  @default(true)
  updatedById            String?
  updatedAt              DateTime @updatedAt

  updatedBy PlatformAdmin? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("platform_system_settings")
}

model PlatformRole {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String   @default("")
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admins PlatformAdminRole[]

  @@map("platform_roles")
}

model PlatformAdminRole {
  adminId  String
  roleId   String
  assignedAt DateTime @default(now())

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role  PlatformRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminId, roleId])
  @@index([roleId])
  @@map("platform_admin_roles")
}

model PlatformSession {
  id           String   @id @default(uuid())
  adminId      String
  tokenHash    String   @unique
  mfaVerified  Boolean  @default(false)
  ipAddress    String?
  userAgent    String?
  lastSeenAt   DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, revokedAt, expiresAt])
  @@map("platform_sessions")
}

model PlatformMfaMethod {
  id              String          @id @default(uuid())
  adminId         String
  kind            PlatformMfaKind @default(totp)
  secretEncrypted String
  verifiedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, kind])
  @@map("platform_mfa_methods")
}

model PlatformAuditEvent {
  id         String               @id @default(uuid())
  actorId    String?
  action     String
  outcome    PlatformAuditOutcome @default(success)
  targetType String?
  targetId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json                 @default("{}")
  createdAt  DateTime             @default(now())

  actor PlatformAdmin? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("platform_audit_events")
}

model PlatformEmailCampaign {
  id             String                      @id @default(uuid())
  createdById    String
  subject        String
  preheader      String?                     @db.Text
  content        Json
  audience       Json
  status         PlatformEmailCampaignStatus @default(draft)
  recipientCount Int                         @default(0)
  sentCount      Int                         @default(0)
  failedCount    Int                         @default(0)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  sentAt         DateTime?
  scheduledAt    DateTime?
  cancelledAt    DateTime?

  createdBy PlatformAdmin          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  deliveries PlatformEmailDelivery[]

  @@index([createdById, createdAt])
  @@index([status, createdAt])
  @@map("platform_email_campaigns")
}

model PlatformEmailDelivery {
  id           String                      @id @default(uuid())
  campaignId   String
  recipientEmail String
  recipientName  String?
  recipientUserId String?
  status       PlatformEmailDeliveryStatus @default(pending)
  providerId   String?
  error        String?                     @db.Text
  sentAt       DateTime?
  attempts     Int                         @default(0)
  nextAttemptAt DateTime?                  @default(now())
  leaseUntil   DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  bouncedAt    DateTime?
  complainedAt DateTime?
  createdAt    DateTime                    @default(now())

  campaign PlatformEmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, recipientEmail])
  @@index([campaignId, status])
  @@map("platform_email_deliveries")
}

model PlatformEmailSuppression {
  id        String   @id @default(uuid())
  email     String   @unique
  reason    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_email_suppressions")
}

model PlatformEmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String
  preheader String?  @db.Text
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_email_templates")
}
