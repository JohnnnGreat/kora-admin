DATABASE_URL="postgresql://kora_admin_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/kora_admin?schema=public"
DOCKER_DATABASE_URL="postgresql://kora_admin_app:REPLACE_WITH_URL_ENCODED_PASSWORD@host.docker.internal:5432/kora_admin?schema=public"
PORT=3006
NODE_ENV=production
ADMIN_FRONTEND_URL=http://localhost:5176
SESSION_TTL_HOURS=12
COOKIE_SECURE=true

# Read-only connection to the existing tenant ERP database. Required before
# organization-management endpoints are enabled.
TENANT_DATABASE_URL=

# Mutations are sent to the core ERP so platform administration uses the
# same provisioning and invitation workflow as Kora itself.
KORA_CORE_API_URL=http://host.docker.internal:3000/api
KORA_CORE_SERVICE_TOKEN=REPLACE_WITH_A_SHARED_RANDOM_TOKEN

# Required to send platform email campaigns. Use a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM="EMRC Platform <no-reply@example.com>"
EMAIL_QUEUE_ENABLED=true
EMAIL_WORKER_INTERVAL_MS=10000
# Signs the per-recipient unsubscribe link every sent email carries, and the
# token that link's click has to present back. Required for unsubscribe to
# work at all — without it, every unsubscribe attempt is rejected.
EMAIL_UNSUBSCRIBE_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
# Verifies Resend's webhook signature (Settings -> Webhooks -> Signing
# Secret in the Resend dashboard, starts with whsec_). Point the webhook
# itself at POST {this API's public URL}/api/email-events/resend-webhook,
# subscribed to email.delivered, email.opened, email.bounced and
# email.complained. Left blank, webhooks are accepted unverified — fine for
# local testing, not for anything exposed to the internet.
RESEND_WEBHOOK_SECRET=

# Used only by `pnpm admin:create`; do not keep a real password in this file.
PLATFORM_ADMIN_EMAIL=owner@example.com
PLATFORM_ADMIN_NAME=Platform Owner
PLATFORM_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
